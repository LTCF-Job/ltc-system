# LTC Transport System - Frontend Environment Variables

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Supabase 專案（怎麼取得這兩個值見 ../../docs/tech/environment-bootstrap.md）
# 缺其中一個時 src/lib/supabase.ts 的 supabase client 會是 null，
# 登入頁會直接顯示帳密錯誤而不會真的呼叫 Supabase Auth
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
