# LTC Transport System - Frontend Environment Variables

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google Cloud OAuth 2.0 Client ID (for Google Identity Services)
# e.g., 123456789012-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=

# Google Cloud API Key (for Google Picker API)
# e.g., AIzaSyDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_GOOGLE_API_KEY=

# Google Cloud Project App ID (Optional)
VITE_GOOGLE_APP_ID=
