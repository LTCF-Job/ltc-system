# LTC Transport System - Frontend Environment Variables

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Supabase 專案（怎麼取得這兩個值見 ../../docs/tech/environment-bootstrap.md）
# local 環境一律使用本機 mock 登入，這兩個值不會改變登入模式；
# 非 local 環境必須同時設定，才會啟用 Supabase Auth
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 應用程式環境標記（本機設為 local，正式／預覽環境保持為空或設為 production）
VITE_APP_ENV=local
