PORT=8080
APP_ENV=local
# production 或 demo；demo 只能連 ltc_demo 資料庫，且只接受帶 app_metadata.data_plane=demo 的 JWT（見 ../../docs/tech/environment-bootstrap.md）
DATA_PLANE=production
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/ltc_system?sslmode=disable
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
# 32 bytes base64 encoded keys
ENCRYPTION_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
HMAC_KEY=OTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=
SUPABASE_JWKS_URL=
SUPABASE_PROJECT_REF=
# APP_ENV=production 時必填，逗號分隔的前端網域清單（怎麼設定見 ../../docs/tech/environment-bootstrap.md）
ALLOWED_ORIGINS=
STORAGE_BUCKET=ltc-exports
STORAGE_SIGNED_URL_TTL=24h
RESEND_API_KEY=
NOTIFY_FROM=noreply@ltc.example.com
SENTRY_DSN=
LOG_LEVEL=info
