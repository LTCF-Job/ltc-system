# 正式環境用（docker-compose.prod.yml）
# 複製為 .env.prod 並填入實際值，或改由部署平台的 secret 機制注入，不要把 .env.prod 提交進 git
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
ENCRYPTION_KEY=
HMAC_KEY=
SUPABASE_JWKS_URL=
SUPABASE_PROJECT_REF=
ALLOWED_ORIGINS=
RESEND_API_KEY=
SENTRY_DSN=
